{
  // Cloudflare Worker: static-assets only (no server code).
  // This file is what lets Cloudflare's Git integration ("Workers Builds")
  // deploy the app on every push — you never have to run wrangler yourself.
  "name": "side-quest",
  "compatibility_date": "2025-06-01",
  "assets": {
    // Everything in ./public is served as-is at the site root.
    "directory": "./public",
    // Single-page app: unknown paths fall back to index.html, while real
    // files (manifest.json, icons, _headers) are still served directly.
    "not_found_handling": "single-page-application"
  }
}
